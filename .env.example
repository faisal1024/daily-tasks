# Copy this file to `.env.local` (gitignored) and fill in your key.
# The proxy and Expo both read `.env.local` automatically for local dev.
#
# Which AI backend the proxy uses. Switch providers by changing this one value.
# Supported: openai | anthropic
MOMENTUM_AI_PROVIDER=anthropic

# --- OpenAI (used when MOMENTUM_AI_PROVIDER=openai) ---
OPENAI_API_KEY=sk-proj-your-server-side-key
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic / Claude (used when MOMENTUM_AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-server-side-key
# Strong model for the plan; use claude-haiku-4-5 for cheap, fast generation.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Proxy server ---
PORT=8787
# CORS: "*" is for local dev only. In production set this to the app's origin.
# Leave unset to send no cross-origin header at all.
CORS_ORIGIN=*
# Abuse protection. Set a shared secret in production; the app must send it as
# the `x-momentum-secret` header. Leave empty for local dev.
PROXY_SHARED_SECRET=
# Max requests per client IP per minute.
RATE_LIMIT_PER_MIN=30

# --- App ---
EXPO_PUBLIC_MOMENTUM_AI_PROXY_URL=http://localhost:8787/api/momentum/plan
